@page "/"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Lançar</PageTitle>

<div class="tabs">
    <button class="tab-button @(tipo == TipoLancamento.Gasto ? "active" : "")" @onclick="() => MudarTipoAsync(TipoLancamento.Gasto)">
        Gasto
    </button>
    <button class="tab-button @(tipo == TipoLancamento.Receita ? "active" : "")" @onclick="() => MudarTipoAsync(TipoLancamento.Receita)">
        Receita
    </button>
</div>

@if (mensagemErro is not null)
{
    <p class="alert-error">@mensagemErro</p>
}
@if (mensagemSucesso is not null)
{
    <p class="alert-warning">@mensagemSucesso</p>
}
@foreach (var alerta in alertasOrcamento)
{
    <p class="alert-error">⚠ @alerta</p>
}

<EditForm Model="this" OnValidSubmit="SalvarAsync">
    <div class="field">
        <label for="valor">Valor (R$)</label>
        <input id="valor" type="text" inputmode="decimal" @bind="valorTexto" @bind:event="oninput" placeholder="0,00" />
    </div>

    <div class="field">
        <label for="categoria">Categoria</label>
        <select id="categoria" @bind="categoriaId">
            <option value="">Selecione...</option>
            @foreach (var categoria in categorias)
            {
                <option value="@categoria.Id">@categoria.Nome</option>
            }
        </select>
    </div>

    @if (tipo == TipoLancamento.Gasto)
    {
        <div class="field">
            <label for="formaPagamento">Forma de pagamento</label>
            <select id="formaPagamento" @bind="formaPagamento" @bind:after="() => parcelado = false">
                @foreach (var forma in Enum.GetValues<FormaPagamento>())
                {
                    <option value="@forma">@forma</option>
                }
            </select>
        </div>

        @if (formaPagamento == FormaPagamento.Credito)
        {
            <div class="field field--checkbox">
                <label>
                    <input type="checkbox" @bind="parcelado" />
                    Compra parcelada
                </label>
            </div>

            @if (parcelado)
            {
                <div class="field">
                    <label for="totalParcelas">Número de parcelas</label>
                    <input id="totalParcelas" type="number" min="2" max="60" step="1" @bind="totalParcelas" />
                </div>
            }
        }
    }

    <div class="field">
        <label for="data">Data</label>
        <input id="data" type="date" @bind="data" />
    </div>

    <div class="field">
        <label for="descricao">Descrição</label>
        <input id="descricao" type="text" @bind="descricao" placeholder="Opcional" />
    </div>

    <button type="submit" class="btn-primary" disabled="@salvando">
        @(salvando ? "Salvando..." : tipo == TipoLancamento.Gasto ? "Lançar gasto" : "Lançar receita")
    </button>
</EditForm>

@code {
    private TipoLancamento tipo = TipoLancamento.Gasto;
    private List<CategoriaDto> categorias = [];
    private string valorTexto = string.Empty;
    private DateOnly data = DateOnly.FromDateTime(DateTime.Now);
    private string descricao = string.Empty;
    private int? categoriaId;
    private FormaPagamento formaPagamento = FormaPagamento.Pix;
    private bool parcelado;
    private int totalParcelas = 2;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private List<string> alertasOrcamento = [];
    private bool salvando;

    protected override Task OnInitializedAsync() => CarregarCategoriasAsync();

    private async Task MudarTipoAsync(TipoLancamento novoTipo)
    {
        tipo = novoTipo;
        categoriaId = null;
        parcelado = false;
        mensagemSucesso = null;
        mensagemErro = null;
        await CarregarCategoriasAsync();
    }

    private async Task CarregarCategoriasAsync()
    {
        categorias = await Api.GetCategoriasAsync(tipo);
    }

    private async Task SalvarAsync()
    {
        mensagemErro = null;
        mensagemSucesso = null;
        alertasOrcamento = [];

        var valor = Formatacao.ParseValorDigitado(valorTexto);

        if (valor is null or <= 0)
        {
            mensagemErro = "Informe um valor maior que zero.";
            return;
        }

        if (categoriaId is null)
        {
            mensagemErro = "Selecione uma categoria.";
            return;
        }

        var estaParcelando = tipo == TipoLancamento.Gasto && formaPagamento == FormaPagamento.Credito && parcelado;
        if (estaParcelando && totalParcelas < 2)
        {
            mensagemErro = "Informe pelo menos 2 parcelas.";
            return;
        }

        salvando = true;
        try
        {
            if (tipo == TipoLancamento.Gasto)
            {
                var resultado = await Api.RegistrarGastoAsync(new CriarGastoRequest(
                    valor.Value, data, descricao, categoriaId.Value, formaPagamento, null,
                    estaParcelando ? totalParcelas : null));

                mensagemSucesso = resultado is { TotalParcelasGeradas: > 1 }
                    ? $"Compra parcelada em {resultado.TotalParcelasGeradas}x lançada (1ª parcela de {Formatacao.Moeda(resultado.Lancamento.Valor)})."
                    : $"Gasto de {Formatacao.Moeda(valor.Value)} lançado.";
                alertasOrcamento = resultado?.AlertasOrcamento.ToList() ?? [];
            }
            else
            {
                await Api.RegistrarReceitaAsync(new CriarReceitaRequest(
                    valor.Value, data, descricao, categoriaId.Value, null));
                mensagemSucesso = $"Receita de {Formatacao.Moeda(valor.Value)} lançada.";
            }

            valorTexto = string.Empty;
            descricao = string.Empty;
            parcelado = false;
        }
        catch (ApiException ex)
        {
            mensagemErro = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }
}
