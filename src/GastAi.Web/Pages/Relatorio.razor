@page "/relatorio"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Relatório mensal</PageTitle>

<div class="month-picker">
    <button class="btn-link" @onclick="MesAnteriorAsync">‹ Anterior</button>
    <span class="month-picker__label">@NomeMes(mes) @ano</span>
    <button class="btn-link" @onclick="ProximoMesAsync">Próximo ›</button>
</div>

@if (mensagemErro is not null)
{
    <p class="alert-error">@mensagemErro</p>
}

@if (carregando)
{
    <p>Carregando...</p>
}
else if (relatorio is not null)
{
    <div class="summary-grid">
        <div class="summary-item">
            <div class="summary-item__label">Receitas</div>
            <div class="summary-item__value">@Formatacao.Moeda(relatorio.TotalReceitas)</div>
        </div>
        <div class="summary-item">
            <div class="summary-item__label">Gastos</div>
            <div class="summary-item__value">@Formatacao.Moeda(relatorio.TotalGastos)</div>
        </div>
        <div class="summary-item" style="grid-column: span 2;">
            <div class="summary-item__label">Saldo do mês</div>
            <div class="summary-item__value" style="color: @(relatorio.Saldo >= 0 ? "var(--color-primary-dark)" : "var(--color-danger)")">
                @Formatacao.Moeda(relatorio.Saldo)
            </div>
        </div>
    </div>

    @if (relatorio.ComparacaoMesAnterior.ExisteDadosMesAnterior)
    {
        <div class="card">
            <strong>Comparação com o mês anterior</strong>
            <p>Gastos: @Formatacao.Percentual(relatorio.ComparacaoMesAnterior.VariacaoPercentualGastos) em relação a @Formatacao.Moeda(relatorio.ComparacaoMesAnterior.TotalGastosMesAnterior)</p>
            <p>Receitas: @Formatacao.Percentual(relatorio.ComparacaoMesAnterior.VariacaoPercentualReceitas) em relação a @Formatacao.Moeda(relatorio.ComparacaoMesAnterior.TotalReceitasMesAnterior)</p>
        </div>
    }

    <div class="card">
        <strong>Gasto por categoria</strong>
        @if (relatorio.GastosPorCategoria.Count == 0)
        {
            <p>Nenhum gasto neste mês.</p>
        }
        else
        {
            @foreach (var item in relatorio.GastosPorCategoria)
            {
                var expandida = categoriaExpandida == item.CategoriaId;
                <div class="category-row" style="cursor:pointer" @onclick="() => AlternarCategoria(item.CategoriaId)">
                    <span class="category-row__dot" style="background: @CorCategoria(item.CategoriaId)"></span>
                    <div style="flex:1">
                        <div style="display:flex; justify-content:space-between; font-size:0.9rem;">
                            <span>@item.CategoriaNome</span>
                            <span>@Formatacao.Moeda(item.Valor) (@item.Percentual%)</span>
                        </div>
                        <div class="category-row__bar-track">
                            <div class="category-row__bar-fill" style="width:@(item.Percentual)%; background:@CorCategoria(item.CategoriaId);"></div>
                        </div>
                        @if (relatorio.ComparacaoMesAnterior.ExisteDadosMesAnterior)
                        {
                            <div class="variacao @ClasseVariacao(item.Valor, item.ValorMesAnterior)">
                                @TextoVariacaoCategoria(item)
                            </div>
                        }
                    </div>
                    <span class="category-row__chevron">@(expandida ? "▾" : "▸")</span>
                </div>

                @if (expandida)
                {
                    var lancamentosDaCategoria = LancamentosDaCategoria(item.CategoriaId);
                    <div class="category-row__detalhes">
                        @if (lancamentosDaCategoria.Count == 0)
                        {
                            <p style="font-size:0.85rem; color:var(--color-muted); margin:0.4rem 0;">Nenhum lançamento nesta categoria.</p>
                        }
                        else
                        {
                            @foreach (var lancamento in lancamentosDaCategoria)
                            {
                                <div class="lancamento-row lancamento-row--nested">
                                    <div>
                                        <div>@(string.IsNullOrWhiteSpace(lancamento.Descricao) ? "Sem descrição" : lancamento.Descricao)</div>
                                        <div style="font-size:0.75rem; color:var(--color-muted);">@lancamento.Data.ToString("dd/MM")</div>
                                    </div>
                                    <div style="display:flex; align-items:center; gap:0.6rem;">
                                        <span style="color: var(--color-danger)">-@Formatacao.Moeda(lancamento.Valor)</span>
                                        <button class="btn-danger" title="Excluir" @onclick="() => ExcluirAsync(lancamento.Id)">✕</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            }
        }
    </div>

    <div class="card">
        <strong>Contas que se repetem</strong>
        <p style="font-size:0.8rem; color:var(--color-muted); margin:0.2rem 0 0.8rem;">
            Gastos com a mesma categoria e descrição em pelo menos 2 dos últimos 6 meses (ex.: conta de luz).
        </p>
        @if (recorrentes.Count == 0)
        {
            <p>Ainda não há gastos repetidos. Use sempre a mesma descrição (ex.: "Conta de luz") para acompanhar a evolução.</p>
        }
        else
        {
            @foreach (var r in recorrentes)
            {
                var maximo = r.Serie.Max(s => s.Valor);
                <div class="recorrente">
                    <div style="display:flex; justify-content:space-between; gap:0.6rem;">
                        <div>
                            <div>@r.Descricao</div>
                            <div style="font-size:0.75rem; color:var(--color-muted);">@r.CategoriaNome</div>
                        </div>
                        <div style="text-align:right;">
                            <div>@(r.ValorAtual is null ? "—" : Formatacao.Moeda(r.ValorAtual.Value))</div>
                            <div class="variacao @ClasseTendencia(r.Tendencia)">@TextoTendencia(r)</div>
                        </div>
                    </div>
                    <div class="recorrente__grafico">
                        @foreach (var ponto in r.Serie)
                        {
                            var altura = maximo == 0 ? 0 : Math.Max(4, (int)Math.Round(ponto.Valor / maximo * 100));
                            var atual = ponto.Ano == ano && ponto.Mes == mes;
                            <div class="recorrente__coluna" title="@NomeMesCurto(ponto.Mes)/@ponto.Ano: @Formatacao.Moeda(ponto.Valor)">
                                <div class="recorrente__trilho">
                                    <div class="recorrente__barra @(atual ? "recorrente__barra--atual" : "")"
                                         style="height:@(ponto.Valor == 0 ? 0 : altura)%"></div>
                                </div>
                                <span class="recorrente__mes">@NomeMesCurto(ponto.Mes)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="card">
        <strong>Lançamentos do mês</strong>
        @if (lancamentos.Count == 0)
        {
            <p>Nenhum lançamento neste mês.</p>
        }
        else
        {
            @foreach (var lancamento in lancamentos)
            {
                <div class="lancamento-row">
                    <div>
                        <div>@lancamento.CategoriaNome @(string.IsNullOrWhiteSpace(lancamento.Descricao) ? "" : $"— {lancamento.Descricao}")</div>
                        <div style="font-size:0.8rem; color:var(--color-muted);">@lancamento.Data.ToString("dd/MM")</div>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.6rem;">
                        <span style="color: @(lancamento.Tipo == TipoLancamento.Gasto ? "var(--color-danger)" : "var(--color-primary-dark)")">
                            @(lancamento.Tipo == TipoLancamento.Gasto ? "-" : "+")@Formatacao.Moeda(lancamento.Valor)
                        </span>
                        <button class="btn-danger" title="Excluir" @onclick="() => ExcluirAsync(lancamento.Id)">✕</button>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    private int ano;
    private int mes;
    private RelatorioMensalDto? relatorio;
    private List<LancamentoDto> lancamentos = [];
    private List<GastoRecorrenteDto> recorrentes = [];
    private bool carregando;
    private string? mensagemErro;
    private int? categoriaExpandida;

    private static readonly string[] Paleta =
        ["#F97316", "#3B82F6", "#8B5CF6", "#EC4899", "#EF4444", "#22C55E", "#14B8A6", "#EAB308", "#6B7280"];

    protected override Task OnInitializedAsync()
    {
        var hoje = DateOnly.FromDateTime(DateTime.Now);
        ano = hoje.Year;
        mes = hoje.Month;
        return CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        carregando = true;
        mensagemErro = null;
        try
        {
            relatorio = await Api.GetRelatorioMensalAsync(ano, mes);
            lancamentos = await Api.GetLancamentosAsync(ano, mes);
            recorrentes = await Api.GetGastosRecorrentesAsync(ano, mes);
        }
        catch (ApiException ex)
        {
            mensagemErro = ex.Message;
        }
        finally
        {
            carregando = false;
        }
    }

    private Task MesAnteriorAsync()
    {
        var novaData = new DateOnly(ano, mes, 1).AddMonths(-1);
        ano = novaData.Year;
        mes = novaData.Month;
        return CarregarAsync();
    }

    private Task ProximoMesAsync()
    {
        var novaData = new DateOnly(ano, mes, 1).AddMonths(1);
        ano = novaData.Year;
        mes = novaData.Month;
        return CarregarAsync();
    }

    private async Task ExcluirAsync(int id)
    {
        try
        {
            await Api.ExcluirLancamentoAsync(id);
            await CarregarAsync();
        }
        catch (ApiException ex)
        {
            mensagemErro = ex.Message;
        }
    }

    private string CorCategoria(int categoriaId) => Paleta[categoriaId % Paleta.Length];

    private void AlternarCategoria(int categoriaId)
        => categoriaExpandida = categoriaExpandida == categoriaId ? null : categoriaId;

    private List<LancamentoDto> LancamentosDaCategoria(int categoriaId) =>
        lancamentos
            .Where(l => l.Tipo == TipoLancamento.Gasto && l.CategoriaId == categoriaId)
            .OrderByDescending(l => l.Data)
            .ToList();

    // Para gasto, subir é ruim (vermelho) e cair é bom (verde).
    private static string ClasseVariacao(decimal atual, decimal anterior)
        => atual > anterior ? "variacao--sobe" : atual < anterior ? "variacao--cai" : "";

    private static string TextoVariacaoCategoria(GastoPorCategoriaDto item)
    {
        if (item.ValorMesAnterior == 0)
            return "Novo: sem gasto no mês anterior";

        if (item.Valor == 0)
            return $"▼ Sem gastos (mês anterior: {Formatacao.Moeda(item.ValorMesAnterior)})";

        var seta = item.Valor > item.ValorMesAnterior ? "▲" : item.Valor < item.ValorMesAnterior ? "▼" : "=";
        return $"{seta} {Formatacao.Percentual(item.VariacaoPercentual)} (mês anterior: {Formatacao.Moeda(item.ValorMesAnterior)})";
    }

    private static string ClasseTendencia(TendenciaGasto tendencia) => tendencia switch
    {
        TendenciaGasto.Subindo => "variacao--sobe",
        TendenciaGasto.Caindo => "variacao--cai",
        _ => ""
    };

    private static string TextoTendencia(GastoRecorrenteDto r)
    {
        if (r.ValorAtual is null)
            return "Não lançado neste mês";

        if (r.VariacaoPercentual is null)
            return "Sem mês anterior para comparar";

        var seta = r.Tendencia switch { TendenciaGasto.Subindo => "▲", TendenciaGasto.Caindo => "▼", _ => "=" };
        return $"{seta} {Formatacao.Percentual(r.VariacaoPercentual)} vs {Formatacao.Moeda(r.ValorAnterior!.Value)}";
    }

    private static string NomeMesCurto(int mes)
        => new DateTime(2000, mes, 1).ToString("MMM", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));

    private static string NomeMes(int mes) => new DateTime(2000, mes, 1).ToString("MMMM", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
}
