@inherits LayoutComponentBase
@inject ApiClient Api
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="app-header">
        <span class="app-header__title">GastAi</span>
        <button class="logout-button" title="Sair" @onclick="SairAsync">Sair</button>
    </header>

    <main class="app-content">
        @Body
    </main>

    <nav class="bottom-nav">
        <NavLink class="bottom-nav__item" href="" Match="NavLinkMatch.All">
            <span class="bottom-nav__icon">＋</span>
            <span>Lançar</span>
        </NavLink>
        <NavLink class="bottom-nav__item" href="relatorio">
            <span class="bottom-nav__icon">▤</span>
            <span>Relatório</span>
        </NavLink>
        <NavLink class="bottom-nav__item" href="categorias">
            <span class="bottom-nav__icon">◎</span>
            <span>Categorias</span>
        </NavLink>
    </nav>
</div>

@code {
    private async Task SairAsync()
    {
        await Api.LogoutAsync();
        AuthStateProvider.NotificarMudancaDeEstado();
        Navigation.NavigateTo("/login", forceLoad: false);
    }
}
